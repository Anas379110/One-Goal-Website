---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { isPublished, relatedArticles } from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', isPublished);
  return articles.map((article) => ({
    params: { slug: article.slug }, // Astro built-in slug (من اسم الملف)
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const { Content } = await article.render();

const allArticles = await getCollection('articles', isPublished);
const related = relatedArticles(allArticles, article, 3);
---
<BaseLayout title={article.data.title} description={article.data.excerpt}>
  <article>
    <span class="text-xs text-pitch font-medium">{article.data.category.replace('_', ' ')}</span>
    <h1 class="text-3xl font-bold mt-2 mb-2">{article.data.title}</h1>
    <time class="text-sm text-neutral-500 block mb-6">
      {new Intl.DateTimeFormat('ar', { dateStyle: 'long' }).format(article.data.publishDate)}
    </time>

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>

    <!-- FR5 — عرض المصدر إلزامي (شفافية + منع الهلوسة) -->
    <div class="mt-8 pt-4 border-t border-neutral-200 text-sm text-neutral-600">
      <strong>المصادر:</strong>
      <ul class="list-disc list-inside">
        {article.data.sources.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </article>

  {related.length > 0 && (
    <section class="mt-10">
      <h2 class="text-xl font-bold mb-4">مقالات ذات صلة</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {related.map((r) => (
          <ArticleCard
            title={r.data.title}
            slug={r.slug}
            category={r.data.category}
            publishDate={r.data.publishDate}
            excerpt={r.data.excerpt}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
