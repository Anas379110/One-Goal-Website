---
export interface Props {
  title: string;
  slug: string;
  category: string;
  publishDate: Date;
  excerpt: string;
}
const { title, slug, category, publishDate, excerpt } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('ar', { dateStyle: 'medium' }).format(publishDate);
---
<a href={`/article/${slug}`} class="block border border-neutral-200 rounded-lg p-4 hover:shadow-md transition-shadow bg-white">
  <span class="text-xs text-pitch font-medium">{category.replace('_', ' ')}</span>
  <h3 class="text-lg font-bold mt-1 mb-2">{title}</h3>
  <p class="text-sm text-neutral-700 mb-2">{excerpt}</p>
  <time datetime={publishDate.toISOString()} class="text-xs text-neutral-500">{formattedDate}</time>
</a>
